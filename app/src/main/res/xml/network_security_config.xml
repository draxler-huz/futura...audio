<?xml version="1.0" encoding="utf-8"?>
<!--
    The app keeps cleartext HTTP disabled everywhere except the on-device
    loopback proxy used by the advanced (Category 2) pipeline. That proxy
    binds 127.0.0.1 and streams to itself, so cleartext is scoped to
    localhost only and never leaves the device.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
